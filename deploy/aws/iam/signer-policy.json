{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UploadToStaging",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::__S3_BUCKET__/staging/users/*"
    },
    {
      "Sid": "ReadDocuments",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::__S3_BUCKET__/files/users/*"
    }
  ]
}
