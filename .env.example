# Copy to .env for local development. `npm run dev` loads it with --env-file;
# the server itself never reads .env, so set these in the environment in production.

# Listen port.
PORT=8080

# "production" turns on Secure cookies and trusts one proxy hop by default.
NODE_ENV=development

# Region for both S3 and DynamoDB. Required.
AWS_REGION=eu-west-1

# Private bucket that holds uploaded documents. Required. Without S3_ENDPOINT
# the name must not contain dots: browsers reach it at
# https://<bucket>.s3.<region>.amazonaws.com.
S3_BUCKET=

# DynamoDB table (single-table layout, keys PK/SK, TTL attribute "ttl").
DYNAMODB_TABLE=idv-portal

# Endpoint overrides for a local S3 / DynamoDB. Leave empty to use AWS.
# Presigned URLs point at S3_ENDPOINT, so the browser must be able to reach it.
S3_ENDPOINT=
DYNAMODB_ENDPOINT=

# The SDK needs credentials even for local endpoints; any value works there.
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# IAM role whose credentials sign the presigned URLs, assumed through STS with
# the default credentials (the instance role in production). Leave empty to
# sign with the default credentials themselves, which is fine locally.
# S3_SIGNER_ROLE_ARN=arn:aws:iam::123456789012:role/idv-portal-signer

# Largest accepted document, in MiB.
MAX_UPLOAD_MB=10

# Lifetime of an upload URL (60 to 1800 seconds) and of a read URL (10 to 1800).
UPLOAD_URL_TTL_SECONDS=300
DOWNLOAD_URL_TTL_SECONDS=60

# How long a sign-in stays valid.
SESSION_TTL_DAYS=7

# Express "trust proxy" setting: a hop count, "false", or a subnet list.
# "true" is refused because it would trust X-Forwarded-For from any client.
# Defaults to 1 in production and 0 otherwise.
# TRUST_PROXY=1

# pino level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
