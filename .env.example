# Copy to .env for local development. `npm run dev` loads it with --env-file;
# the server itself never reads .env, so set these in the environment in production.

# Listen port.
PORT=8080

# "production" turns on Secure cookies and trusts one proxy hop by default.
NODE_ENV=development

# Region for both S3 and DynamoDB. Required.
AWS_REGION=eu-west-1

# Private bucket that holds uploaded documents. Required.
S3_BUCKET=

# DynamoDB table (single-table layout, keys PK/SK, TTL attribute "ttl").
DYNAMODB_TABLE=idv-portal

# Endpoint overrides for a local S3 / DynamoDB. Leave empty to use AWS.
S3_ENDPOINT=
DYNAMODB_ENDPOINT=

# The SDK needs credentials even for local endpoints; any value works there.
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test

# Largest accepted document, in MiB.
MAX_UPLOAD_MB=10

# Uploads accepted at the same time. Each one is held in memory up to
# MAX_UPLOAD_MB; beyond this number the service answers 503.
MAX_CONCURRENT_UPLOADS=100

# How long a sign-in stays valid.
SESSION_TTL_DAYS=7

# Express "trust proxy" setting: a hop count, "false", or a subnet list.
# "true" is refused because it would trust X-Forwarded-For from any client.
# Defaults to 1 in production and 0 otherwise.
# TRUST_PROXY=1

# pino level: fatal, error, warn, info, debug, trace or silent.
LOG_LEVEL=info
